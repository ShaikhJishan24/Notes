    @Autowired
    private JwtUtil jwtUtil;

    @Autowired
    private googleAuthService googleAuthService;

    // REGISTER
    public userModel register(userDTO dto) {

        user entity = new user();
        entity.setName(dto.getName());
        entity.setPwd(passwordEncoder.encode(dto.getPwd()));

        user saved = userRepository.save(entity);

        userModel model = new userModel();
        model.setId(saved.getId());
        model.setName(saved.getName());
        model.setPwd(null); // never expose password

        return model;
    }

    // LOGIN
    public String login(userDTO dto) {

        user u = userRepository.findByName(dto.getName())
                .orElseThrow(() -> new RuntimeException("Invalid username or password"));

        if (!passwordEncoder.matches(dto.getPwd(), u.getPwd())) {
            throw new RuntimeException("Invalid username or password");
        }

        return jwtUtil.generateToken(u.getName());
    }


