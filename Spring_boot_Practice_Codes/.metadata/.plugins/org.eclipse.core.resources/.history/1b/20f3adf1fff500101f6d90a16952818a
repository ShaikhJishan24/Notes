package com.jwt.jwtDemo.controller;

import com.jwt.jwtDemo.dto.userDTO;
import com.jwt.jwtDemo.model.userModel;
import com.jwt.jwtDemo.service.userService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.core.annotation.AuthenticationPrincipal;
import org.springframework.security.oauth2.core.user.OAuth2User;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/user")
public class userController {


    @Autowired
    private userService userService;

    // CREATE USER
    @PostMapping
    public ResponseEntity<userModel> createUser(@RequestBody userDTO dto) {

        userModel model = userService.createUser(dto);
        return ResponseEntity.status(HttpStatus.CREATED).body(model);
    }

    // GET USER BY ID
    @GetMapping("/{id}")
    public ResponseEntity<userModel> getUser(@PathVariable int id) {

        userModel model = userService.getUserById(id);
        return ResponseEntity.ok(model);
    }

    @GetMapping
    public ResponseEntity<List<userModel>> getUsers(){

        List<userModel> lm = userService.getUsers();
        return ResponseEntity.ok(lm);
    }
    
