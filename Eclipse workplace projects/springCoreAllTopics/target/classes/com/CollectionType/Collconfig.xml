<?xml version="1.0" encoding="UTF-8"?>

<beans  
    xmlns="http://www.springframework.org/schema/beans"  
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
    xmlns:p="http://www.springframework.org/schema/p"  
    xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">  
  
	<bean id="Que" class="com.CollectionType.Questions">  
	
		<property name="id" value="10"></property> 
		<property name="Question" value="What is java"></property>
		
		<property name="Answer">
		   <list>
		      <value>It is a programming language</value>
		      <value>it is purly object oriented programming langauge</value>
		      <value>Open source platform</value>
		   </list>
		</property> 
	
    </bean> 
 
</beans>