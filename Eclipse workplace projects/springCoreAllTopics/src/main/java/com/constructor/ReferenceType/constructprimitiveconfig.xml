<?xml version="1.0" encoding="UTF-8"?>

<beans  
    xmlns="http://www.springframework.org/schema/beans"  
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
    xmlns:p="http://www.springframework.org/schema/p"  
    xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">  
  
  
   <bean id="pd" class="com.constructor.PrimitiveType.ProjectDetail">
	   <constructor-arg value="1" type="int"></constructor-arg>
	   <constructor-arg value="Becoder"></constructor-arg>
   </bean>
   
	<bean id="pro" class="com.constructor.PrimitiveType.Project"> 
		<constructor-arg value="1" type="int"></constructor-arg> 
		<constructor-arg value="Hotel Management System" ></constructor-arg>
		<!-- it is internally uses constructor to inject object (Dependency injection) -->
		<constructor-arg ref="pd"></constructor-arg>
    </bean> 
 
</beans>