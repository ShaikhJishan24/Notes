<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>List</title>
<style>
  li{
   font-size : 25px;
   color : red;
  }
  
</style>
</head>
<body>
         <h1>Ordered List</h1>
         <ol>
            <li>Home</li>
            <li>About</li>
            <li>Contact</li>
         </ol>
         
         
         <h1>Unorderd List</h1>
         <ul>
            <li>Home</li>
            <li>About</li>
            <li>Contact</li>
         </ul>
</body>
</html>