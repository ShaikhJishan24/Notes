<?xml version="1.0" encoding="UTF-8"?>

<beans  
    xmlns="http://www.springframework.org/schema/beans"  
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
    xmlns:p="http://www.springframework.org/schema/p"  
    xmlns:context="http://www.springframework.org/schema/context"
    xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
               http://www.springframework.org/schema/context
               http://www.springframework.org/schema/context/spring-context.xsd" 
               >  
  
    
    <context:annotation-config/>
    <!-- 1st bean or object of Address class-->
	<bean id="address" class="AutowiredAmbiguityProblem.Address">
	    <constructor-arg value="Maharastra"></constructor-arg>
	    <constructor-arg value="India"></constructor-arg> 
    </bean>
    
    <!-- 2nd bean or object of Address class-->
	<bean id="address2" class="AutowiredAmbiguityProblem.Address">
	    <constructor-arg value="Abu Dhabi"></constructor-arg>
	    <constructor-arg value="Dubai"></constructor-arg> 
    </bean>


	<bean id="emp" class="AutowiredAmbiguityProblem.Employee" >
		<constructor-arg value="101" type="int"></constructor-arg>
		<constructor-arg value="John Doe"></constructor-arg>
	</bean>
	
 
</beans>